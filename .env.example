# Environment Configuration for Fin-Lit

# Application
NEXT_PUBLIC_APP_NAME="Fin-Lit"
NEXT_PUBLIC_APP_TAGLINE="Understand your money. Control your spending. Build your financial future."
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
NEXT_PUBLIC_DEFAULT_LOCALE="en-IN"

# Database (Prisma SQLite by default for zero-friction local run; switchable to PostgreSQL)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/finlit?schema=public"

# AI Integration (Optional: Gemini API key for live LLM reasoning; deterministic fallback active if unset)
GEMINI_API_KEY=""

# Security / Session secret
SESSION_SECRET="finlit-super-secret-key-change-in-production-min-32-chars"
NODE_ENV="development"
